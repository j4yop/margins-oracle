# ────────────────────────────────────────────────────────────────────
# MARGINS — env.example
# Copy to web/.env.local and fill in. ALL keys below have free tiers.
# ────────────────────────────────────────────────────────────────────

# ── Gemini API (free at https://aistudio.google.com/) ─────────────
# Server-side only. NEVER use NEXT_PUBLIC_ for this key.
GEMINI_API_KEY=AIza...
GEMINI_MODEL_PRO=gemini-2.5-flash
GEMINI_MODEL_FLASH=gemini-2.5-flash-lite
GEMINI_MODEL_TTS=gemini-2.5-flash-preview-tts

# ── Firebase (free Spark plan — no card needed) ───────────────────
# Browser config (public by design). Enable "Anonymous" provider in
# Authentication → Sign-in method so the ledger can write securely.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Server-side Firebase Admin (optional but recommended) ─────────
# Enables order/audit/ledger server writes and MCP ledger reads.
# Paste raw JSON or base64-encoded JSON of a service account.
FIREBASE_SERVICE_ACCOUNT_KEY=

# ── Live mandi benchmarks (optional) ──────────────────────────────
# Free key from https://data.gov.in (developer plan). When set, staple/oil
# categories query the live Agmarknet-sourced mandi dataset; otherwise a
# documented MRP-based wholesale model is used (honestly labeled).
DATA_GOV_IN_API_KEY=

# ── ONDC Beckn (Dual Gateway: mock | staging) ─────────────────────
BECKN_MODE=mock                            # 'mock' = in-process reference BPP
ONDC_GATEWAY_URL=                          # e.g. https://staging.gateway.ondc.org
ONDC_SUBSCRIBER_ID=margins.bap.ondc
ONDC_KEY_ID=margins-key-1
ONDC_SIGNING_PRIVATE_KEY=                  # base64 Ed25519 key (PKCS8 DER or raw 32-byte seed)
BECKN_BPP_ID=margins-ref-bpp
BECKN_BPP_URI=                             # public URL of the reference BPP in staging
APP_URL=                                   # public origin of THIS app (used to build bap_uri)

# ── Wholesale model parameter ─────────────────────────────────────
WHOLESALE_FACTOR=0.85                      # benchmark = MRP × factor (clamped 0.5–0.99)

# ── Security & ops (all optional) ─────────────────────────────────
ADMIN_TOKEN=                               # bearer token to read raw /api/audit rows
MCP_ACCESS_TOKEN=                          # if set, MCP tools/call requires Authorization: Bearer
NEXT_PUBLIC_MERCHANT_UPI_VPA=              # fallback UPI VPA for the fair-settlement lock
                                           # (the UI collects the distributor's VPA per-store)

# ── Demo tunables ────────────────────────────────────────────────
DEMO_CITY=Madurai
DEMO_LANGUAGE=ta
DEMO_PRODUCT_GTIN=8901058851649          # Amul Butter 500g (sample)
