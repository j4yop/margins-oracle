# ────────────────────────────────────────────────────────────────────
# MARGINS — env.example
# Copy to .env.local and fill in. ALL keys below have free tiers.
# ────────────────────────────────────────────────────────────────────

# ── Gemini API (free at https://aistudio.google.com/) ─────────────
GEMINI_API_KEY=AIza...                    # AI Studio API key
GEMINI_MODEL_PRO=gemini-2.5-pro
GEMINI_MODEL_FLASH=gemini-2.5-flash
GEMINI_MODEL_LIVE=gemini-2.0-flash-exp    # Live API model (free preview)

# ── Firebase (free Spark plan — no card needed) ───────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── GS1 India (free for hackathon use; takes 1–2 days to approve) ─
GS1_API_KEY=
# fallback: when key arrives, set GS1_MODE=live; otherwise uses barcodespider
GS1_MODE=fallback

# ── Beckn reference apps (running locally during dev) ─────────────
BECKN_BPP_URL=http://localhost:4001
BECKN_BAP_URL=http://localhost:4002
BECKN_BPP_ID=margins-ref-bpp
BECKN_BPP_URI=http://localhost:4001

# ── Bhashini (free for hackathon use) ─────────────────────────────
BHASHINI_API_KEY=
BHASHINI_USER_ID=

# ── Public free data sources (no keys required) ───────────────────
AGMARKNET_BASE_URL=https://agmarknet.gov.in
OPENCITY_BASE_URL=https://data.opencity.in
GOOGLE_SHOPPING_GROUNDING=enabled

# ── MCP server (margins-mcp) ──────────────────────────────────────
MCP_SERVER_PORT=3001
MCP_SERVER_PUBLIC_URL=https://margins-mcp.example.com   # set after deploy

# ── Demo tunables ────────────────────────────────────────────────
DEMO_CITY=Madurai
DEMO_LANGUAGE=ta
DEMO_PRODUCT_GTIN=8901058851649          # Amul Butter 500g (sample)