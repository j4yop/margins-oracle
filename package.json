{
  "name": "margins",
  "version": "0.1.0",
  "private": true,
  "description": "MARGINS — Multimodal Agent for Reading, Grounding, Indexing & Negotiating Smarter. A Gemini-native fairness oracle for India's 63M MSMEs.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "deploy": "next build && firebase deploy --only hosting",
    "functions:deploy": "firebase deploy --only functions",
    "mcp:dev": "tsx api/mcp-server/index.ts",
    "beckn:bpp": "cd beckn/ref-bpp && npm run dev",
    "beckn:bap": "cd beckn/ref-bap && npm run dev"
  },
  "dependencies": {
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@google/generative-ai": "^0.21.0",
    "firebase": "^10.13.0",
    "firebase-admin": "^12.5.0",
    "tailwindcss": "^3.4.10",
    "zustand": "^4.5.5",
    "zod": "^3.23.8",
    "axios": "^1.7.4",
    "@modelcontextprotocol/sdk": "^1.0.4"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "@types/react": "^18.3.5",
    "typescript": "^5.5.4",
    "tsx": "^4.19.0",
    "tailwindcss": "^3.4.10",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.45",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.5"
  },
  "engines": {
    "node": ">=18"
  }
}